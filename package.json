{
  "name": "learn-with-me",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start:fe": "ng serve",
    "start:fe:lan": "ng serve --host 0.0.0.0 --ssl",
    "start:be": "tsx watch projects/backend/src/app.ts",
    "test:fe": "ng test",
    "test:be": "npm run build:be && tsc -p projects/backend/tsconfig.test.json && cd projects/backend && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "build:be:prod": "node projects/backend/build-prod.cjs",
    "build:fe:prod": "ng build",
    "build:fe:static": "ng build --configuration static",
    "db:generate": "drizzle-kit generate --config=projects/backend/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=projects/backend/drizzle.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "semi": false,
    "trailingComma": "none",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/service-worker": "^22.0.8",
    "@fastify/autoload": "^6.4.0",
    "@fastify/sensible": "^6.0.4",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/remixicon": "^35.0.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "fastify-cli": "^8.0.0",
    "fastify-tsconfig": "^3.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.9.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
