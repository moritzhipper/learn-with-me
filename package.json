{
  "name": "learn-with-me",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:fe": "ng serve",
    "build:fe": "ng build",
    "watch:fe": "ng build --watch --configuration development",
    "test:fe": "ng test",
    "build:be": "tsc -p projects/backend/tsconfig.app.json && tsc-alias -p projects/backend/tsconfig.app.json",
    "watch:be": "concurrently \"tsc -w -p projects/backend/tsconfig.app.json\" \"tsc-alias -w -p projects/backend/tsconfig.app.json\"",
    "start:be": "npm run build:be && fastify start -l info dist/backend/backend/src/app.js",
    "dev:be": "npm run build:be && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:be\" \"npm:dev:start:be\"",
    "dev:start:be": "fastify start --ignore-watch=.ts$ -w -l info -P dist/backend/backend/src/app.js",
    "test:be": "npm run build:be && tsc -p projects/backend/tsconfig.test.json && cd projects/backend && c8 node --test -r ts-node/register \"test/**/*.ts\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "semi": false,
    "trailingComma": "none",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^20.5.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@ngrx/signals": "^21.0.1",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "openai": "^6.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^25.0.3",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-tsconfig": "^3.0.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
