  "learnables": [
    {
      "lexeme": "...listed according to their overall length (LOA)...",
      "translation": "...उनकी कुल लंबाई (LOA) के अनुसार सूचीबद्ध हैं...",
      "type": "phrase",
      "id": "a8cad611-dc78-4b20-8373-94339e88f3db",
      "notes": ""
    },
    {
      "lexeme": "...the maximum length of the vessel measured between the extreme points in fore and aft",
      "translation": "...जहाज़ की अधिकतम लंबाई जो आगे और पीछे के चरम सिरों के बीच मापी जाती है",
      "type": "phrase",
      "id": "bfc220e7-c886-4da5-96e0-b86aae4a6a3b",
      "notes": ""
    },
    {
      "lexeme": "In addition, the ships' deadweight tonnage (DWT) and/or gross tonnage (GT) are presented...",
      "translation": "इसके अतिरिक्त, जहाज़ों का डेडवेट टनेज (DWT) और/या ग्रॉस टनेज (GT) भी प्रस्तुत किया जाता है...",
      "type": "phrase",
      "id": "16d08d27-e555-4f1d-acfe-32cb50c6c2d7",
      "notes": ""
    },
    {
      "lexeme": "...as they are often used to describe the size of a vessel",
      "translation": "...क्योंकि इन्हें अक्सर किसी जहाज़ के आकार का वर्णन करने के लिए उपयोग किया जाता है",
      "type": "phrase",
      "id": "691e0aad-0b04-4036-81d1-a0bf8403c14c",
